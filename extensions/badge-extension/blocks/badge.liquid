{%- liquid
  assign badge_product = product
  if block.settings.product != blank
    assign badge_product = block.settings.product
  endif

  assign manual_badge = badge_product.metafields.custom_badges.active_badge.value
  assign automation = app.metafields.badgify.automation.value
  assign variant = badge_product.selected_or_first_available_variant

  assign badge_type = ''
  assign badge_label = ''
  assign custom_css = ''

  # 1. A manually assigned badge always wins.
  if manual_badge != blank and manual_badge.label.value != blank
    assign badge_type = 'manual'
    assign badge_label = manual_badge.label.value | escape
    assign bg_color = manual_badge.bg_color.value | default: block.settings.fallback_bg_color
    assign text_color = manual_badge.text_color.value | default: block.settings.fallback_text_color
    assign radius = manual_badge.border_radius.value | default: block.settings.fallback_border_radius
    assign font_size = manual_badge.font_size.value | default: block.settings.fallback_font_size
    assign padding_x = manual_badge.padding_x.value | default: 8
    assign padding_y = manual_badge.padding_y.value | default: 4

    # Only allow CSS declarations: stripping braces and angle brackets keeps
    # merchant CSS inside the badge rule and out of the surrounding markup.
    assign custom_css = manual_badge.css_custom.value | remove: '<' | remove: '>' | remove: '{' | remove: '}' | strip

  # 2. Otherwise the first matching automated rule: Sold out > Sale > Low stock > New.
  elsif automation != blank
    if automation.sold_out.enabled and badge_product.available == false
      assign badge_type = 'sold_out'
      assign badge_label = automation.sold_out.label | escape
    endif

    if badge_type == '' and automation.sale.enabled and variant.compare_at_price > variant.price
      assign saved = variant.compare_at_price | minus: variant.price
      assign percent = saved | times: 100.0 | divided_by: variant.compare_at_price | round
      assign amount = saved | money
      assign badge_type = 'sale'
      assign badge_label = automation.sale.label | escape | replace: '{percent}', percent | replace: '{amount}', amount
    endif

    if badge_type == '' and automation.low_stock.enabled and variant.inventory_management == 'shopify'
      if variant.inventory_quantity > 0 and variant.inventory_quantity <= automation.low_stock.threshold
        assign badge_type = 'low_stock'
        assign badge_label = automation.low_stock.label | escape | replace: '{count}', variant.inventory_quantity
      endif
    endif

    # Published, not created: products often sit in draft before launch.
    if badge_type == '' and automation.new_arrival.enabled and badge_product.published_at != blank
      assign now_seconds = 'now' | date: '%s' | plus: 0
      assign published_seconds = badge_product.published_at | date: '%s' | plus: 0
      assign age_days = now_seconds | minus: published_seconds | divided_by: 86400
      if age_days < automation.new_arrival.days
        assign badge_type = 'new_arrival'
        assign badge_label = automation.new_arrival.label | escape
      endif
    endif

    if badge_type != ''
      assign rule = automation[badge_type]
      assign bg_color = rule.bg_color | default: block.settings.fallback_bg_color
      assign text_color = rule.text_color | default: block.settings.fallback_text_color
      assign radius = automation.style.border_radius | default: block.settings.fallback_border_radius
      assign font_size = automation.style.font_size | default: block.settings.fallback_font_size
      assign padding_x = automation.style.padding_x | default: 8
      assign padding_y = automation.style.padding_y | default: 4
    endif
  endif

  if block.settings.layout == 'overlay'
    assign position_class = 'badgify--' | append: block.settings.corner
  else
    assign position_class = 'badgify--' | append: block.settings.alignment
  endif
-%}

{%- if badge_type != '' -%}
  {%- if custom_css != blank -%}
    <style>
      #badgify-{{ block.id }} .badgify-badge { {{ custom_css }} }
    </style>
  {%- endif -%}

  <div
    id="badgify-{{ block.id }}"
    class="badgify badgify--{{ block.settings.layout }} {{ position_class }}"
    data-badge-type="{{ badge_type }}"
    style="
      --badgify-bg: {{ bg_color }};
      --badgify-color: {{ text_color }};
      --badgify-radius: {{ radius }}px;
      --badgify-font-size: {{ font_size }}px;
      --badgify-px: {{ padding_x }}px;
      --badgify-py: {{ padding_y }}px;
      --badgify-offset-x: {{ block.settings.offset_x }}px;
      --badgify-offset-y: {{ block.settings.offset_y }}px;
      --badgify-spacing: {{ block.settings.spacing }}px;
    "
    {{ block.shopify_attributes }}
  >
    <span class="badgify-badge badgify-badge--{{ badge_type }}">{{ badge_label }}</span>
  </div>
{%- elsif request.design_mode -%}
  <p class="badgify-editor-hint" {{ block.shopify_attributes }}>
    {{ 'badgify.editor_hint' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Product badge",
  "target": "section",
  "stylesheet": "badgify.css",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true,
      "info": "Defaults to the product on the current page."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Position",
      "options": [
        { "value": "inline", "label": "Inline" },
        { "value": "overlay", "label": "Overlay" }
      ],
      "default": "inline",
      "info": "Overlay floats the badge over nearby content without taking up space."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment (inline)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing (inline)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "corner",
      "label": "Corner (overlay)",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-left"
    },
    {
      "type": "range",
      "id": "offset_x",
      "label": "Horizontal offset (overlay)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "offset_y",
      "label": "Vertical offset (overlay)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Fallback style",
      "info": "Used when a badge doesn't define its own value."
    },
    {
      "type": "color",
      "id": "fallback_bg_color",
      "label": "Background color",
      "default": "#D72C0D"
    },
    {
      "type": "color",
      "id": "fallback_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "fallback_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "fallback_font_size",
      "label": "Font size",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
